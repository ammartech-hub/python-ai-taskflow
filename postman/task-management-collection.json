{
  "info": {
    "_postman_id": "a9c67812-78d1-4e2b-b6d3-9f88d2c41f77",
    "name": "AI-Powered Task Management System API",
    "description": "Production-grade Postman collection for the AI-Powered Task Management System. Includes automated test scripts to dynamically capture tokens, IDs, and verify RBAC and AI generation behaviors.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "user_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "task_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"User registered with default 'user' role\", function () {",
                  "    pm.expect(jsonData.role).to.eql('user');",
                  "    pm.expect(jsonData).to.not.have.property('password');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Developer\",\n  \"email\": \"user@taskflow.dev\",\n  \"password\": \"UserPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a new user account with default 'user' role. Rejects duplicate emails with 409."
          }
        },
        {
          "name": "Login as Regular User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Access token issued\", function () {",
                  "    pm.expect(jsonData).to.have.property('access_token');",
                  "});",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set(\"user_token\", jsonData.access_token);",
                  "    pm.environment.set(\"user_token\", jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@taskflow.dev\",\n  \"password\": \"UserPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates regular user credentials and captures Bearer access token into user_token variable."
          }
        },
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Admin access token issued\", function () {",
                  "    pm.expect(jsonData.user.role).to.eql('admin');",
                  "});",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set(\"admin_token\", jsonData.access_token);",
                  "    pm.environment.set(\"admin_token\", jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@taskflow.dev\",\n  \"password\": \"AdminPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates admin account and saves token to admin_token variable."
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Profile contains safe details\", function () {",
                  "    pm.expect(jsonData).to.have.property('email');",
                  "    pm.expect(jsonData).to.not.have.property('password');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Retrieves the caller's safe profile using Bearer JWT."
          }
        }
      ]
    },
    {
      "name": "2. Tasks",
      "item": [
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Default status is Pending\", function () {",
                  "    pm.expect(jsonData.status).to.eql('Pending');",
                  "});",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set(\"task_id\", jsonData.id.toString());",
                  "    pm.environment.set(\"task_id\", jsonData.id.toString());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implement OAuth2 login flow\",\n  \"description\": \"Integrate Google OAuth2 authentication provider and verify JWT token exchange.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/tasks/",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", ""]
            },
            "description": "Creates a new task owned by the authenticated caller. Saves task_id."
          }
        },
        {
          "name": "List Own Tasks",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Paginated items returned\", function () {",
                  "    pm.expect(jsonData).to.have.property('items');",
                  "    pm.expect(jsonData).to.have.property('total');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/tasks/?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", ""],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Lists tasks belonging strictly to the authenticated user."
          }
        },
        {
          "name": "View Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Matches task_id\", function () {",
                  "    pm.expect(jsonData.id.toString()).to.eql(pm.collectionVariables.get('task_id'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "{{task_id}}"]
            },
            "description": "Retrieves task details for an authorized owner or admin."
          }
        },
        {
          "name": "Update Task (Title and Description)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Title updated successfully\", function () {",
                  "    pm.expect(jsonData.title).to.include(\"Updated\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implement OAuth2 login flow (Updated)\",\n  \"description\": \"Added support for PKCE flow alongside standard token exchange.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "{{task_id}}"]
            },
            "description": "Allows task owner to modify title and description."
          }
        },
        {
          "name": "Attempt Status Update as Regular User (Verify 403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Detail message mentions status modification restriction\", function () {",
                  "    pm.expect(jsonData.detail.toLowerCase()).to.include(\"status\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sneaky status modification attempt\",\n  \"status\": \"Completed\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "{{task_id}}"]
            },
            "description": "Enforces authorization rule: regular users cannot alter task status and must receive HTTP 403."
          }
        },
        {
          "name": "Attempt Access Another User's Task (Verify 404 Not Found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/tasks/99999",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "99999"]
            },
            "description": "Enforces security isolation: accessing non-owned task ID returns HTTP 404 to avoid enumeration."
          }
        }
      ]
    },
    {
      "name": "3. AI Features",
      "item": [
        {
          "name": "Generate Task Description",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 503 if API key unconfigured\", function () {",
                  "    pm.expect([200, 503]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.test(\"AI description returned\", function () {",
                  "        pm.expect(jsonData).to.have.property('description');",
                  "        pm.expect(jsonData.description.length).to.be.above(10);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Prepare monthly sales report\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/tasks/generate-description",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "generate-description"]
            },
            "description": "Invokes Google Gemini AI to generate a professional, concise task description."
          }
        }
      ]
    },
    {
      "name": "4. Admin Management",
      "item": [
        {
          "name": "View All Tasks as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Contains global task records\", function () {",
                  "    pm.expect(jsonData.items.length).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/tasks/?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", ""],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Allows administrators to view tasks across all users."
          }
        },
        {
          "name": "Update Task Status as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Status transitioned to In Progress\", function () {",
                  "    pm.expect(jsonData.status).to.eql(\"In Progress\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Progress\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/tasks/{{task_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "{{task_id}}", "status"]
            },
            "description": "Admin-only status transition endpoint: moves task to Pending, In Progress, Testing, or Completed."
          }
        },
        {
          "name": "Get System Stats as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Analytics contain user and task breakdown\", function () {",
                  "    pm.expect(jsonData).to.have.property('total_users');",
                  "    pm.expect(jsonData).to.have.property('total_tasks');",
                  "    pm.expect(jsonData).to.have.property('tasks_by_status');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/stats",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "stats"]
            },
            "description": "Returns operational system statistics: total users, total tasks, and distribution by status."
          }
        }
      ]
    }
  ]
}
