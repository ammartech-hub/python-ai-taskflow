{
  "version": 2,
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/frontend/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "frontend/**",
      "maxDuration": 15
    }
  }
}
