# ==============================================================================
# Database Configuration
# ==============================================================================
# For PostgreSQL with psycopg v3 (default recommended):
DATABASE_URL=postgresql+psycopg://postgres:your_secure_password_here@localhost:5433/task_management
# For local SQLite development/testing fallback:
# DATABASE_URL=sqlite:///./task_management.db

# ==============================================================================
# Security & JWT Authentication
# ==============================================================================
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# Google Gemini AI Integration
# ==============================================================================
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# Application Settings
# ==============================================================================
APP_NAME=AI-Powered Task Management System
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
# Optional explicit API base URL for decoupled frontend hosting:
# API_BASE_URL=https://python-ai-taskflow-b3cb.vercel.app

# ==============================================================================
# Seed Data Configuration (Used by scripts/seed.py)
# ==============================================================================
SEED_ADMIN_EMAIL=admin@taskflow.dev
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_USER_EMAIL=user@taskflow.dev
SEED_USER_PASSWORD=UserPass123!
